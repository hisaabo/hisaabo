# DEPRECATED — this file is no longer used.
#
# The parity check is now fully automatic. See:
#   parity-exceptions.yaml  — intentional exclusions only
#   scripts/check-parity.ts — auto-detects tRPC usage across all platforms
#
# This file is kept for historical reference only and is NOT read by any tooling.
# ---------------------------------------------------------------------------
# Original contents below.
# ---------------------------------------------------------------------------
# Feature Parity Matrix -- Hisaabo
#
# This file was the source of truth for which features are implemented on which
# platform. It was checked by CI on every PR and used to generate release notes.
#
# Status values:
#   implemented    -- feature is fully working on this platform
#   partial        -- some sub-features or screens exist, but not complete
#   planned        -- explicitly on the roadmap, tracked in an issue/milestone
#   not-started    -- not yet planned or prioritised
#   not-applicable -- this feature does not make sense for this platform
#   placeholder    -- a screen/route exists but shows "Coming soon" with no logic
#
# Platforms:
#   web     -- apps/web (React + TanStack Router). Desktop wraps this, so desktop
#              is always at parity with web and is omitted from this matrix.
#   mobile  -- apps/mobile (Expo / React Native)
#   store   -- apps/store (public customer-facing storefront, REST not tRPC)
#   cli     -- packages/cli (Ink / Node.js terminal client)
#   mcp     -- packages/mcp (Model Context Protocol server)
#
# Each feature maps to one or more tRPC procedures (or REST endpoints for store).
# The `api` field lists every procedure the feature depends on.
#
# Maintainers: when you add a new procedure to packages/api/src/routers/ or a
# new screen to any app, update this file in the same PR.

schema_version: "1.0"

# ============================================================================
# AUTHENTICATION
# ============================================================================
features:

  - id: auth.register
    name: Password Registration
    category: Authentication
    api: [auth.register]
    platforms:
      web: implemented
      mobile: implemented
      store: not-applicable
    notes: "Web and mobile both support email+password registration."

  - id: auth.login
    name: Password Login
    category: Authentication
    api: [auth.login]
    platforms:
      web: implemented
      mobile: implemented
      store: not-applicable

  - id: auth.magic-link
    name: Magic Link Login
    category: Authentication
    api: [auth.sendMagicLink, auth.verifyMagicLink]
    platforms:
      web: implemented
      mobile: implemented
      store: not-applicable
    notes: "Mobile uses deep links for token verification."

  - id: auth.complete-profile
    name: Complete Profile (post magic-link)
    category: Authentication
    api: [auth.completeProfile]
    platforms:
      web: implemented
      mobile: implemented
      store: not-applicable
    notes: "Mobile has a complete-profile screen with a gate that redirects users who haven't set a name yet."

  - id: auth.update-name
    name: Update Display Name
    category: Authentication
    api: [auth.updateName]
    platforms:
      web: implemented
      mobile: implemented
      store: not-applicable
    notes: "Web has this in Settings > Account tab. Mobile has this in Settings > Profile tab (updateName mutation)."

  - id: auth.email-change
    name: Change Email Address
    category: Authentication
    api: [auth.requestEmailChange, auth.confirmEmailChange]
    platforms:
      web: implemented
      mobile: implemented
      store: not-applicable
    notes: "Mobile Settings > Profile tab has requestEmailChange. confirmEmailChange is handled via deep-link (same as magic-link flow)."

  - id: auth.logout
    name: Logout
    category: Authentication
    api: [auth.logout]
    platforms:
      web: implemented
      mobile: implemented
      store: not-applicable

  - id: auth.logout-all
    name: Logout All Sessions
    category: Authentication
    api: [auth.logoutAll]
    platforms:
      web: not-started
      mobile: implemented
      store: not-applicable
    notes: "Mobile settings screen has a 'logout all devices' action. Web has no UI for this yet."

  - id: auth.me
    name: Current Session / User Info
    category: Authentication
    api: [auth.me]
    platforms:
      web: implemented
      mobile: implemented
      store: not-applicable

