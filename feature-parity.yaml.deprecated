    name: Switch Active Tenant
    category: Multi-Tenancy
    api: [tenant.select]
    platforms:
      web: implemented
      mobile: implemented
      store: not-applicable
    notes: "Mobile app layout auto-selects the tenant via tenant.select mutation when only one tenant exists."

  - id: tenant.current
    name: Current Tenant Info
    category: Multi-Tenancy
    api: [tenant.current]
    platforms:
      web: implemented
      mobile: not-applicable
      store: not-applicable
