{
  "expo": {
    "name": "Hisaabo",
    "slug": "hisaabo",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hisaabo",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0f0f1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.hisaabo.app",
      "associatedDomains": ["applinks:app.hisaabo.in"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5b5bd6"
      },
      "package": "in.hisaabo.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.hisaabo.in"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-system-ui",
      "expo-local-authentication",
      [
        "expo-contacts",
        {
          "contactsPermission": "Hisaabo needs access to your contacts to help you create invoices faster."
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}