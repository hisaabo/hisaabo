{
  "expo": {
    "name": "Hisaabo",
    "slug": "hisaabo",
    "version": "0.9.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hisaabo",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0f0f1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.hisaabo.app",
      "associatedDomains": [
        "applinks:app.hisaabo.in"
      ],
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5b5bd6"
      },
      "package": "in.hisaabo.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.hisaabo.in",
              "pathPrefix": "/auth/native/callback"
            },
            {
              "scheme": "https",
              "host": "app.hisaabo.in",
              "pathPrefix": "/auth/verify"
            },
            {
              "scheme": "https",
              "host": "app.hisaabo.in",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-system-ui",
      "expo-local-authentication",
      [
        "expo-contacts",
        {
          "contactsPermission": "Hisaabo needs access to your contacts to help you create invoices faster."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ]
    ]
  }
}
