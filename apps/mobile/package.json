{
  "name": "@hisaabo/mobile",
  "version": "0.7.5",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:android": "EXPO_PUBLIC_API_URL=http://$(hostname -I | awk '{print $1}'):3000 expo start --android",
    "dev:ios": "expo start --ios",
    "dev:web": "expo start --web",
    "prebuild": "expo prebuild",
    "build:apk": "bash scripts/build-apk.sh",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings ./app ./src",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.9",
    "@expo/vector-icons": "~15.1.1",
    "@hisaabo/shared": "workspace:*",
    "@react-native-community/datetimepicker": "8.6.0",
    "@tanstack/react-query": "^5.62.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "expo": "~55.0.11",
    "expo-clipboard": "^55.0.11",
    "expo-constants": "~55.0.11",
    "expo-contacts": "~55.0.11",
    "expo-file-system": "~55.0.14",
    "expo-font": "~55.0.6",
    "expo-haptics": "55.0.11",
    "expo-linking": "~55.0.11",
    "expo-local-authentication": "~55.0.11",
    "expo-router": "~55.0.10",
    "expo-secure-store": "~55.0.11",
    "expo-sharing": "~55.0.16",
    "expo-splash-screen": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "^55.0.13",
    "invariant": "^2.2.4",
    "react": "^19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-worklets": "0.7.2",
    "superjson": "^2.2.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@hisaabo/api": "workspace:*",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "jest": "^29.0.0",
    "jest-expo": "~55.0.13",
    "typescript": "~5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "maxWorkers": 2,
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@trpc|superjson)"
    ]
  }
}
