{
  "name": "@hisaabo/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:android": "EXPO_PUBLIC_API_URL=http://$(hostname -I | awk '{print $1}'):3000 expo start --android",
    "dev:ios": "expo start --ios",
    "dev:web": "expo start --web",
    "prebuild": "expo prebuild",
    "build:apk": "bash scripts/build-apk.sh",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings ./app ./src",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@expo/vector-icons": "~14.1.0",
    "@hisaabo/shared": "workspace:*",
    "@react-native-community/datetimepicker": "8.4.1",
    "@tanstack/react-query": "^5.62.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "expo": "~53.0.27",
    "expo-constants": "~17.1.8",
    "expo-contacts": "~14.2.6",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "14.1.4",
    "expo-linking": "~7.1.7",
    "expo-local-authentication": "~16.0.5",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "invariant": "^2.2.4",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.5",
    "react-native-safe-area-context": "~5.4.0",
    "react-native-screens": "~4.11.1",
    "superjson": "^2.2.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@hisaabo/api": "workspace:*",
    "@testing-library/jest-native": "^5.0.0",
    "@testing-library/react-native": "^12.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.0.14",
    "jest": "^29.0.0",
    "jest-expo": "~53.0.14",
    "typescript": "~5.8.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "maxWorkers": 2,
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@trpc|superjson)"
    ]
  }
}
