    "strict": true,
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["jest", "@testing-library/jest-native"],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
