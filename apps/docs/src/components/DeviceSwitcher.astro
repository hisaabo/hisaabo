---
/**
 * Device switcher toggle — auto-detects user's device (desktop/mobile)
 * and lets them override manually. Persists choice in localStorage.
 * Placed next to the theme toggle via ThemeSelect override.
 */
---

<div class="device-switcher" role="radiogroup" aria-label="View docs for">
  <button
    class="device-switcher-btn"
    data-platform-target="desktop"
    aria-pressed="false"
    title="Desktop guide"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
      <line x1="8" y1="21" x2="16" y2="21"></line>
      <line x1="12" y1="17" x2="12" y2="21"></line>
    </svg>
    <span>Desktop</span>
  </button>
  <button
    class="device-switcher-btn"
    data-platform-target="mobile"
    aria-pressed="false"
    title="Mobile guide"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
      <line x1="12" y1="18" x2="12.01" y2="18"></line>
    </svg>
    <span>Mobile</span>
  </button>
</div>

<script is:inline>
  (function () {
    function getDefaultPlatform() {
      var stored = localStorage.getItem('hisaabo-docs-platform');
      if (stored === 'desktop' || stored === 'mobile') return stored;
      var isMobile =
        /Android|iPhone|iPad|iPod/i.test(navigator.userAgent) ||
        window.innerWidth < 768;
      return isMobile ? 'mobile' : 'desktop';
    }

    function setPlatform(platform) {
      document.documentElement.setAttribute('data-platform', platform);
      localStorage.setItem('hisaabo-docs-platform', platform);
      document.querySelectorAll('.device-switcher-btn').forEach(function (btn) {
        var isActive = btn.getAttribute('data-platform-target') === platform;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      });
    }

    // Apply stored state or auto-detect
    setPlatform(getDefaultPlatform());

    // Event delegation — works regardless of how many copies of the buttons exist
    if (!document.__platformDelegated) {
      document.__platformDelegated = true;
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('.device-switcher-btn');
        if (!btn) return;
        var target = btn.getAttribute('data-platform-target');
        if (target) setPlatform(target);
      });
    }
  })();
</script>
