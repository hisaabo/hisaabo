{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hisaabo",
  "version": "0.3.4",
  "identifier": "in.hisaabo.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @hisaabo/web dev",
    "beforeBuildCommand": "pnpm --filter @hisaabo/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Hisaabo",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:3000 https://*.hisaabo.in https://*.pages.dev; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["hisaabo"]
      }
    }
  }
}
