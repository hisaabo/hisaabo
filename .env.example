# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://hisaabo:your_secure_password@localhost:5432/hisaabo

# ── API Server ──────────────────────────────────────────────────
PORT=3000
CORS_ORIGINS=http://localhost:5173,https://your-domain.pages.dev

# ── Trusted proxy / client IP ─────────────────────────────────
# TRUST_PROXY_HOPS: trusted reverse proxies in front of the API (default 1; 0 =
# ignore X-Forwarded-For, use when the API is exposed directly).
# TRUST_CLOUDFLARE=true: honour cf-connecting-ip (only if reachable solely via Cloudflare).
# TRUST_PROXY_HOPS=1
# TRUST_CLOUDFLARE=false

# ── Export / import token signing (optional) ──────────────────
# Tokens are signed with a key derived from the first of ENCRYPTION_KEY,
# SESSION_SECRET, EXPORT_SECRET that is set (a fixed built-in secret is used in
# development when none is). Production requires ENCRYPTION_KEY, so leave these
# unset there.
# SESSION_SECRET=
# EXPORT_SECRET=

# ── Node environment ────────────────────────────────────────────
NODE_ENV=development
# LOG_LEVEL=debug              # debug | info | warn | error (default: debug here, info in production)
# HISAABO_LOG_STDERR=1         # log to stderr (set by `admin api-key`; for scripts that capture stdout)
# MIGRATION_LOCK_TIMEOUT=5s    # migrations give up on a table lock after this (0 disables), then retry
# MIGRATION_LOCK_RETRIES=5     # retries with backoff after the first attempt

# ── App URL (used for magic link URLs) ────────────────────────
APP_URL=http://localhost:5173
# Self-hosted: first user becomes owner, then sign-up is invite-only.
# ALLOW_OPEN_SIGNUP=true restores open sign-up.
# ALLOW_OPEN_SIGNUP=false

# ── Email (optional — magic links print to console if not set)
RESEND_API_KEY=
EMAIL_FROM=Hisaabo <noreply@yourdomain.com>

# ── Notifications (docs/architecture/notifications.md) ────────
# Mobile push is off by default; the in-app inbox works whenever the worker below
# runs (always, in single-tenant mode). Email copies of critical alerts need
# RESEND_API_KEY (without it they are skipped with one warning per process,
# never an error).
# PUSH_PROVIDER=none                   # none | gorush
# GORUSH_URL=http://gorush:8088        # private network only — Gorush has no auth
# APNS_TOPIC=in.hisaabo.app            # iOS bundle id of YOUR app build
# NOTIFICATIONS_WORKER=                # true | false. Unset = on for single-tenant, OFF when MULTI_TENANT=true
#                                      # (multi-tenant opts in with true; false on replicas that should not dispatch)
# NOTIFICATIONS_FULL_SWEEP_SECONDS=60  # multi-tenant only: how often every tenant is scanned (min 5)

# ── Multi-tenancy (cloud SaaS only) ───────────────────────────
MULTI_TENANT=false
CONTROL_DATABASE_URL=

# ── Field-Level Encryption ────────────────────────────────────
# AES-256-GCM key for encrypting sensitive fields at rest (e-invoice credentials,
# carrier API keys, tenant DB passwords). REQUIRED in production and when MULTI_TENANT=true.
# Must be exactly 64 hex characters (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Previous encryption key — set ONLY during key rotation. Remove after rotation completes.
ENCRYPTION_KEY_PREVIOUS=
# Legacy alias (still supported): DB_ENCRYPTION_KEY is accepted if ENCRYPTION_KEY is not set.
# DB_ENCRYPTION_KEY=

# ── Shipping Webhook Secret ──────────────────────────────────
# HMAC-SHA256 secret for verifying shipping carrier webhook signatures.
SHIPPING_WEBHOOK_SECRET=
# true = reject carrier webhooks without a valid timestamp (optional by default)
# SHIPPING_WEBHOOK_REQUIRE_TIMESTAMP=false

# ── E-way bills (NIC) ─────────────────────────────────────────
# Server-wide NIC E-Way Bill API credentials; all four are needed to generate
# e-way bills. Calls go to the NIC sandbox unless NIC_EWB_SANDBOX is exactly "false".
# NIC_EWB_CLIENT_ID=
# NIC_EWB_CLIENT_SECRET=
# NIC_EWB_USERNAME=
# NIC_EWB_PASSWORD=
# NIC_EWB_SANDBOX=true

# ── E-invoicing (NIC IRP) ─────────────────────────────────────
# The NIC e-invoice public key the IRP sign-in is encrypted with. None is bundled:
# download it from the NIC e-invoice portal you use (sandbox and production keys
# differ) and give the PEM text or a file path. Sandbox mode uses the SANDBOX pair,
# production mode the other; there is no fallback. See docs/DEPLOYMENT.md
# ("E-invoicing (IRP)"). Business IRP credentials are entered in the app.
# IRP_SANDBOX_PUBLIC_KEY_PATH=
# IRP_SANDBOX_PUBLIC_KEY_PEM=
# IRP_PUBLIC_KEY_PATH=
# IRP_PUBLIC_KEY_PEM=

# ── Object Storage (item images) ──────────────────────────────
# Where user-uploaded item images are stored. Bytes live here; only metadata
# and the storage key live in Postgres.
#   local → write to disk (default; zero-config). Point STORAGE_LOCAL_DIR at a
#           persistent volume in production (e.g. /storage/objects on the ONCE
#           image) so images survive container restarts.
#   s3    → any S3-compatible bucket (Cloudflare R2, AWS S3, MinIO).
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=/storage/objects
# For STORAGE_DRIVER=s3:
# STORAGE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_BUCKET=hisaabo-item-images
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# ── Store share metadata / OG image ───────────────────────────
# Absolute base URLs used to build storefront share metadata (Open Graph).
# API_PUBLIC_URL feeds the og:image link (the API serves /store/<slug>/og.png);
# STORE_PUBLIC_URL is the public storefront base shown as the canonical URL.
# Optional but recommended in production: when API_PUBLIC_URL is unset the API
# starts with a warning and falls back to the request origin (PDF pay links),
# then APP_URL / the first CORS_ORIGINS entry. In production a SET value must be a
# valid http(s) URL (startup fails otherwise; elsewhere it is ignored with a warning).
# API_PUBLIC_URL=https://api.hisaabo.in
# STORE_PUBLIC_URL=https://store.hisaabo.in
# Extra origins (comma-separated) and parent domains (any subdomain) allowed to call
# the public store endpoints, in addition to CORS_ORIGINS.
# STORE_ALLOWED_ORIGINS=https://shop.example.com
# STORE_ALLOWED_SUBDOMAINS_OF=hisaabo.in
# Self-host only: if the built store SPA (apps/store/dist) is colocated with the
# API, point this at it so GET /store/<slug> serves the real index.html with
# per-store meta injected. Otherwise a minimal SEO shell is served.
# STORE_DIST_DIR=/app/store
# Override the OG font directory (defaults to the bundled packages/api/fonts).
# OG_FONT_DIR=/app/packages/api/fonts

# ── Tenant Pool (multi-tenant mode) ───────────────────────────
# Tenant connections per process never exceed
#   (TENANT_POOL_MAX + TENANT_POOL_DRAINING_MAX) x TENANT_POOL_PER_DB_MAX
# (500 with the defaults); keep the total over all API processes and workers below Postgres
# max_connections, and never raise TENANT_POOL_MAX alone. About 230 tenants on
# max_connections=100: TENANT_POOL_MAX=10, TENANT_POOL_PER_DB_MAX=2 (bound 40).
# See docs/DEPLOYMENT.md, "Tenant connection budget".
# TENANT_POOL_MAX=50           # Max cached tenant DB pools (LRU eviction)
# TENANT_POOL_DRAINING_MAX=50  # Evicted pools allowed to still hold connections (default: TENANT_POOL_MAX)
# TENANT_POOL_PER_DB_MAX=5     # Connections per tenant pool
# UV_THREADPOOL_SIZE=8          # Prevent Argon2id from saturating libuv pool

# ── Cloudflare Turnstile (online store bot protection) ────────
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=        # Backend secret key (required in production)
VITE_TURNSTILE_SITE_KEY=     # Frontend site key (required in production)
# Turnstile is required on every sign-in request when the secret is set. The only
# exception is the DEPRECATED v0.9.x native-app exemption (see LEGACY_V09_CLIENT_COMPAT
# below); sending X-Hisaabo-Client alone never bypasses it.
# Default on. false = disable all v0.9.x client compatibility (Turnstile exemption for
# installed v0.9.x mobile/desktop apps, bearer-token signature, app handoff). Removed in 0.11.0.
# LEGACY_V09_CLIENT_COMPAT=false

# ── Store phone OTP (optional; per-store toggle, default off) ─
# SMS_PROVIDER=console         # console (dev: logs the code) | webhook
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_SECRET=          # X-Hisaabo-Signature = hex HMAC-SHA256(secret, body)

# ── Native sign-in app links (web build-time) ─────────────────
# Written into /.well-known/assetlinks.json and apple-app-site-association.
# VITE_ANDROID_APP_CERT_SHA256=AB:CD:...   # comma-separated
# VITE_APPLE_TEAM_ID=ABCDE12345

# ── E2E / Test Harness ────────────────────────────────────────
# Set to "1" to bypass the tRPC rate limiter (used by the Playwright
# harness, which seeds data in tight bursts). Ignored in production.
# DISABLE_RATE_LIMIT=1

# ── Browser AI agents (WebMCP) ────────────────────────────────
# Origin-trial token that enables the WebMCP API (document.modelContext) in
# Chrome 149+ / Edge 150+, so the browser's built-in AI agent can discover the
# tools the web app registers. Register a token for YOUR origin at:
#   https://developer.chrome.com/origintrials
# Tokens are per-origin, so self-hosters must register their own. Leave blank
# when testing locally with chrome://flags/#enable-webmcp-testing, and once the
# API ships in stable no token is needed at all.
# WebMCP is off by default (opt-in in Settings); writes need in-app confirmation.
VITE_WEBMCP_ORIGIN_TRIAL_TOKEN=

# ── Background jobs (queue worker) ────────────────────────────
# Jobs live in Postgres (pgboss schema). Run the worker next to the API:
#   pnpm dev (starts both)   |   docker: `command: worker`
# QUEUE_POOLS=default,heavy,system
# QUEUE_CONCURRENCY_DEFAULT=8
# QUEUE_COMPLETED_RETENTION_HOURS=24
# QUEUE_FAILED_RETENTION_DAYS=14
# QUEUE_SHUTDOWN_GRACE_SECONDS=25
# QUEUE_PING_SCHEDULE=false
# QUEUE_DATABASE_URL=                 # default: CONTROL_DATABASE_URL, then DATABASE_URL
# QUEUE_POLLING_INTERVAL_SECONDS=2    # worker idle poll interval (min 0.5)
# QUEUE_HEARTBEAT_FILE=/tmp/worker-heartbeat

# ── Operator dashboard (/ops) ─────────────────────────────────
# Horizon-style queue dashboard served by the API at /ops. OFF unless "true".
# Needs ENCRYPTION_KEY (operator TOTP secrets are encrypted with it).
# Operators are added and enrolled ONLY from the shell:
#   docker compose exec api node packages/api/dist/bin/ops.js help
# See docs/architecture/queue.md §7.2 and docs/DEPLOYMENT.md.
# QUEUE_DASHBOARD_ENABLED=false
# Comma-separated CIDRs allowed to reach /ops (others get a plain 404).
# Strongly recommended in production, e.g. your VPN / office egress.
# OPS_IP_ALLOWLIST=203.0.113.0/24,2001:db8::/32
# OPS_SESSION_IDLE_MINUTES=15
# OPS_SESSION_MAX_HOURS=8
# OPS_STEP_UP_MINUTES=5
