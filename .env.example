# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://hisaabo:your_secure_password@localhost:5432/hisaabo

# ── API Server ──────────────────────────────────────────────────
PORT=3000
CORS_ORIGINS=http://localhost:5173,https://your-domain.pages.dev

# ── Node environment ────────────────────────────────────────────
NODE_ENV=development

# ── App URL (used for magic link URLs) ────────────────────────
APP_URL=http://localhost:5173

# ── Email (optional — magic links print to console if not set)
RESEND_API_KEY=
EMAIL_FROM=Hisaabo <noreply@yourdomain.com>

# ── Multi-tenancy (cloud SaaS only) ───────────────────────────
MULTI_TENANT=false
CONTROL_DATABASE_URL=

# ── Tenant DB Password Encryption ─────────────────────────────
# 64-character hex string (32 bytes). Required in production for multi-tenant.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=

# ── Shipping Webhook Secret ──────────────────────────────────
# HMAC-SHA256 secret for verifying shipping carrier webhook signatures.
SHIPPING_WEBHOOK_SECRET=

# ── Tenant Pool (multi-tenant mode) ───────────────────────────
# TENANT_POOL_MAX=50           # Max cached tenant DB pools (LRU eviction)
# TENANT_POOL_PER_DB_MAX=5     # Connections per tenant pool
# UV_THREADPOOL_SIZE=8          # Prevent Argon2id from saturating libuv pool

# ── Cloudflare Turnstile (online store bot protection) ────────
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=        # Backend secret key (required in production)
VITE_TURNSTILE_SITE_KEY=     # Frontend site key (required in production)
