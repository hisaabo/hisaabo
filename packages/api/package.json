    "argon2": "^0.41.0",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0",
    "nanoid": "^5.0.0",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4",
    "superjson": "^2.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.13.0",
    "@types/qrcode": "^1.5.6",
