{
  "name": "@hisaabo/api",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "maintenance": "tsx src/bin/maintenance.ts",
    "admin": "tsx src/bin/admin.ts",
    "ops": "tsx src/bin/ops.ts",
    "build:ops": "pnpm --filter @hisaabo/ops build && rm -rf dist/ops-public && cp -r ../../apps/ops/dist dist/ops-public"
  },
  "dependencies": {
    "@casl/ability": "^6.8.4",
    "@hisaabo/db": "workspace:*",
    "@hisaabo/shared": "workspace:*",
    "@hono/node-server": "^1.19.19",
    "@resvg/resvg-wasm": "^2.6.2",
    "@trpc/server": "^11.29.5",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "nanoid": "^5.0.0",
    "pdfkit": "^0.21.0",
    "pg-boss": "12.38.2",
    "picocolors": "1.1.1",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "satori": "^0.63.2",
    "superjson": "^2.2.0",
    "tar-stream": "^3.2.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@clack/core": "^1.6.0",
    "@clack/prompts": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/pino": "^7.0.5",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.12",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
