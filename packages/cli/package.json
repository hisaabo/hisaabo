{
  "name": "@hisaabo/cli",
  "version": "0.8.4",
  "description": "Hisaabo command-line interface — manage invoices, parties, items, payments, and reports from your terminal.",
  "keywords": [
    "hisaabo",
    "cli",
    "invoicing",
    "gst",
    "khatabook",
    "vyaapaar"
  ],
  "homepage": "https://github.com/hisaabo/hisaabo/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/hisaabo/hisaabo/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/hisaabo/hisaabo.git",
    "directory": "packages/cli"
  },
  "bin": {
    "hisaabo": "./dist/bin/hisaabo.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
