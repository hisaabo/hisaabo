# ── Hisaabo — ONCE-compatible all-in-one image ─────────────────
# Single container: PostgreSQL 16 + Node API on port 3000
# Managed by s6-overlay for process supervision
#
# ONCE zero-downtime deploy safety:
#   During rolling deploys, two containers share /storage. We use
#   kernel-level flock() to ensure only ONE PostgreSQL instance
#   runs at a time. The new container's API delegates to the old
#   container's PostgreSQL via a Unix socket on the shared volume,
#   then takes over PG ownership when the old container dies.
#
# Persistent data: /storage/pgdata, /storage/run, /storage/backups
# ONCE backup hooks: /hooks/pre-backup, /hooks/post-restore

# ── Stage 1: Build API ────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json ./
COPY packages/api/package.json packages/api/
COPY packages/db/package.json packages/db/
COPY packages/shared/package.json packages/shared/

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY packages/shared/ packages/shared/
COPY packages/db/ packages/db/
COPY packages/api/ packages/api/

# Build the API (tsup bundles server.ts + pdf-worker via tsup.config.ts)
RUN pnpm --filter @hisaabo/api build

# Bundle the migration runner into a standalone JS file (no tsx needed at runtime)
RUN pnpm --filter @hisaabo/db exec esbuild src/migrate.ts \
      --bundle --platform=node --format=esm \
      --target=node22 \
      --outfile=dist/migrate.mjs \
      --external:postgres --external:drizzle-orm --external:dotenv

# ── Stage 2: Production runtime ──────────────────────────────
FROM node:22-alpine AS runtime
WORKDIR /app

# ── System deps ──────────────────────────────────────────────
ARG S6_OVERLAY_VERSION=3.2.0.2
ARG TARGETARCH

RUN apk add --no-cache \
      postgresql16 \
      postgresql16-contrib \
      postgresql16-client \
      flock \
      curl \
      age \
    && mkdir -p /storage/pgdata /storage/run /storage/backups /storage/wal_archive \
    && chown -R postgres:postgres /storage/pgdata /storage/run /storage/wal_archive

# s6-overlay
RUN case "${TARGETARCH}" in \
      amd64) S6_ARCH="x86_64" ;; \
      arm64) S6_ARCH="aarch64" ;; \
      *) S6_ARCH="${TARGETARCH}" ;; \
    esac && \
    curl -fsSL "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz" | tar -C / -Jxpf - && \
    curl -fsSL "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-${S6_ARCH}.tar.xz" | tar -C / -Jxpf -

# ── Node setup ───────────────────────────────────────────────
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY --from=builder /app/packages/api/package.json packages/api/
COPY --from=builder /app/packages/api/dist/ packages/api/dist/
COPY packages/api/fonts/ packages/api/fonts/
COPY packages/db/package.json packages/db/
COPY --from=builder /app/packages/db/dist/migrate.mjs packages/db/dist/
COPY packages/db/drizzle/ packages/db/drizzle/
COPY packages/db/drizzle-control/ packages/db/drizzle-control/
COPY packages/db/drizzle-tenant/ packages/db/drizzle-tenant/
COPY packages/shared/package.json packages/shared/

# Install production deps only — keeps the image lean (no tsup, vitest, etc.)
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --prod

# ── PostgreSQL config ────────────────────────────────────────
COPY scripts/postgresql-wal.conf /etc/postgresql/wal.conf
COPY scripts/postgresql-tuning.conf /etc/postgresql/tuning.conf

# ── Smoke test: catch module resolution errors at build time ──
RUN node --check packages/api/dist/server.js && \
    node -e "import('file:///app/packages/api/dist/server.js').catch(e => { \
      if (e.code === 'ERR_MODULE_NOT_FOUND') { console.error('FATAL:', e.message); process.exit(1); } \
    })"

# ── s6 service: PostgreSQL ───────────────────────────────────
#
# Uses flock() on /storage/.pg_lock to safely coordinate between
# old and new containers during ONCE rolling deploys.
#
# If flock succeeds → we own PG, start it
# If flock blocks  → old container owns PG, we wait until it dies

RUN mkdir -p /etc/s6-overlay/s6-rc.d/postgres/dependencies.d \
    && echo "longrun" > /etc/s6-overlay/s6-rc.d/postgres/type \
    && mkdir -p /etc/s6-overlay/s6-rc.d/user/contents.d \
    && touch /etc/s6-overlay/s6-rc.d/user/contents.d/postgres

COPY <<'PGRUN' /etc/s6-overlay/s6-rc.d/postgres/run
#!/bin/sh
set -e

LOCKFILE="/storage/.pg_lock"
PGDATA="/storage/pgdata"
SOCKETDIR="/storage/run"

mkdir -p "$SOCKETDIR"
chown postgres:postgres "$PGDATA" "$SOCKETDIR" 2>/dev/null || true

# Acquire exclusive flock — blocks until the old container releases it
# This is a KERNEL-LEVEL lock, safe across Docker container PID namespaces
echo "[postgres] Acquiring flock on $LOCKFILE..."
exec flock "$LOCKFILE" /bin/sh -c '
  PGDATA="/storage/pgdata"
  SOCKETDIR="/storage/run"

  echo "[postgres] Lock acquired — we own PostgreSQL"

  # Remove stale socket files left by the old container
  rm -f "$SOCKETDIR/.s.PGSQL.5432" "$SOCKETDIR/.s.PGSQL.5432.lock"

  # Initialize data directory if empty
  if [ ! -f "$PGDATA/PG_VERSION" ]; then
    echo "[postgres] Initializing new database cluster..."
    su-exec postgres /usr/libexec/postgresql16/initdb \
      -D "$PGDATA" --auth=trust --no-locale --encoding=UTF8
    # Allow local + socket connections (container-internal only)
    echo "local all all trust" >> "$PGDATA/pg_hba.conf"
    echo "host all all 127.0.0.1/32 trust" >> "$PGDATA/pg_hba.conf"
  fi

  # Remove stale PID file (safe — we hold the flock, so no other PG is running)
  rm -f "$PGDATA/postmaster.pid"

  echo "[postgres] Starting PostgreSQL..."
  exec su-exec postgres /usr/libexec/postgresql16/postgres \
    -D "$PGDATA" \
    -c listen_addresses=127.0.0.1 \
    -c port=5432 \
    -c max_connections=20 \
    -c shared_buffers=128MB \
    -c unix_socket_directories="$SOCKETDIR" \
    -c include=/etc/postgresql/wal.conf \
    -c include=/etc/postgresql/tuning.conf
'
PGRUN
RUN chmod +x /etc/s6-overlay/s6-rc.d/postgres/run

# ── s6 service: PostgreSQL readiness (oneshot) ───────────────
#
# Waits for PG to be ready — either our own instance (flock acquired)
# or the old container's instance (flock blocked, but socket available)

RUN mkdir -p /etc/s6-overlay/s6-rc.d/postgres-ready/dependencies.d \
    && echo "oneshot" > /etc/s6-overlay/s6-rc.d/postgres-ready/type \
    && touch /etc/s6-overlay/s6-rc.d/postgres-ready/dependencies.d/postgres \
    && touch /etc/s6-overlay/s6-rc.d/user/contents.d/postgres-ready

COPY <<'PGREADY' /etc/s6-overlay/s6-rc.d/postgres-ready/up
#!/bin/sh
set -e
SOCKETDIR="/storage/run"

echo "[pg-ready] Waiting for PostgreSQL (own or delegated)..."

# Wait for PG on the Unix socket — works regardless of which container owns PG
for i in $(seq 1 60); do
  if pg_isready -h "$SOCKETDIR" -U postgres -q 2>/dev/null; then
    echo "[pg-ready] PostgreSQL is ready on $SOCKETDIR"
    # Ensure the hisaabo database exists
    psql -h "$SOCKETDIR" -U postgres -tc \
      "SELECT 1 FROM pg_database WHERE datname = 'hisaabo'" \
      | grep -q 1 \
      || createdb -h "$SOCKETDIR" -U postgres hisaabo
    psql -h "$SOCKETDIR" -U postgres -d hisaabo -c "CREATE EXTENSION IF NOT EXISTS pg_stat_statements"
    exit 0
  fi
  sleep 1
done

echo "[pg-ready] WARNING: PostgreSQL not ready after 60s"
exit 1
PGREADY
RUN chmod +x /etc/s6-overlay/s6-rc.d/postgres-ready/up

# ── s6 service: API ──────────────────────────────────────────

RUN mkdir -p /etc/s6-overlay/s6-rc.d/api/dependencies.d \
    && echo "longrun" > /etc/s6-overlay/s6-rc.d/api/type \
    && touch /etc/s6-overlay/s6-rc.d/api/dependencies.d/postgres-ready \
    && touch /etc/s6-overlay/s6-rc.d/user/contents.d/api

COPY <<'APIRUN' /etc/s6-overlay/s6-rc.d/api/run
#!/bin/sh
set -e
SOCKETDIR="/storage/run"

# Run migrations (idempotent — safe even if old container is still serving)
# Advisory lock inside migrate.mjs prevents conflicts during rolling deploys.
echo "[api] Running database migrations..."
if ! DATABASE_URL="postgresql://postgres@/hisaabo?host=$SOCKETDIR" \
  node /app/packages/db/dist/migrate.mjs; then
  echo "[api] FATAL: Migration failed — refusing to start with inconsistent DB"
  exit 1
fi

# Start API — connects to PG via Unix socket
echo "[api] Starting Hisaabo API on port ${PORT:-80}..."
exec env DATABASE_URL="postgresql://postgres@/hisaabo?host=$SOCKETDIR" \
  node packages/api/dist/server.js
APIRUN
RUN chmod +x /etc/s6-overlay/s6-rc.d/api/run

# ── ONCE hooks ───────────────────────────────────────────────

RUN mkdir -p /hooks

# pre-backup: pg_dump ALL databases to consistent snapshots before ONCE tars /storage
COPY <<'PREBACKUP' /hooks/pre-backup
#!/bin/sh
set -e
SOCKETDIR="/storage/run"

echo "[backup] Discovering databases..."
DATABASES=$(psql -h "$SOCKETDIR" -U postgres -Atc \
  "SELECT datname FROM pg_database WHERE datistemplate = false AND datname != 'postgres'")

for db in $DATABASES; do
  DUMP_FILE="/storage/backups/${db}.dump"
  echo "[backup] Dumping ${db}..."
  pg_dump -h "$SOCKETDIR" -U postgres "$db" \
    --format=custom \
    --compress=6 \
    --file="$DUMP_FILE"

  SIZE=$(du -h "$DUMP_FILE" | cut -f1)

  if [ -n "$BACKUP_ENCRYPTION_KEY" ]; then
    echo "[backup] Encrypting ${db}.dump..."
    echo "$BACKUP_ENCRYPTION_KEY" | age -e -p -o "${DUMP_FILE}.age" "$DUMP_FILE"
    rm -f "$DUMP_FILE"
    ENC_SIZE=$(du -h "${DUMP_FILE}.age" | cut -f1)
    echo "[backup] ${db}: dumped ${SIZE} -> encrypted ${ENC_SIZE}"
  else
    echo "[backup] ${db}: dumped ${SIZE}"
  fi
done

echo "[backup] All database dumps complete"
PREBACKUP
RUN chmod +x /hooks/pre-backup

# post-restore: restore databases from dumps after ONCE unpacks /storage
# Set RESTORE_DB=<dbname> to restore a single tenant database without touching others.
# Leave unset (default) to restore ALL databases.
COPY <<'POSTRESTORE' /hooks/post-restore
#!/bin/sh
set -e
SOCKETDIR="/storage/run"
BACKUP_DIR="/storage/backups"

# If RESTORE_DB is set, only restore that specific database
TARGET_DB="${RESTORE_DB:-}"

# Check if any dumps exist
DUMP_COUNT=$(find "$BACKUP_DIR" -maxdepth 1 -name '*.dump' -o -name '*.dump.age' 2>/dev/null | wc -l)
if [ "$DUMP_COUNT" -eq 0 ]; then
  echo "[restore] No dump files found in $BACKUP_DIR, skipping"
  exit 0
fi

echo "[restore] Waiting for PostgreSQL..."
for i in $(seq 1 30); do
  if pg_isready -h "$SOCKETDIR" -U postgres -q 2>/dev/null; then
    echo "[restore] PostgreSQL is ready"
    break
  fi
  if [ "$i" -eq 30 ]; then
    echo "[restore] ERROR: PostgreSQL not ready after 30s"
    exit 1
  fi
  sleep 1
done

# Decrypt encrypted dumps (.dump.age)
for age_file in "$BACKUP_DIR"/*.dump.age; do
  [ -f "$age_file" ] || continue
  BASENAME=$(basename "$age_file" .dump.age)

  # If targeting a specific DB, skip others
  if [ -n "$TARGET_DB" ] && [ "$BASENAME" != "$TARGET_DB" ]; then
    continue
  fi

  DUMP_FILE="$BACKUP_DIR/${BASENAME}.dump"

  if [ -z "$BACKUP_ENCRYPTION_KEY" ]; then
    echo "[restore] ERROR: ${BASENAME}.dump.age found but BACKUP_ENCRYPTION_KEY is not set"
    exit 1
  fi

  echo "[restore] Decrypting ${BASENAME}.dump.age..."
  echo "$BACKUP_ENCRYPTION_KEY" | age -d -o "$DUMP_FILE" "$age_file"
  rm -f "$age_file"
done

# Restore .dump files
RESTORED=0
for dump_file in "$BACKUP_DIR"/*.dump; do
  [ -f "$dump_file" ] || continue
  DBNAME=$(basename "$dump_file" .dump)

  # If targeting a specific DB, skip others
  if [ -n "$TARGET_DB" ] && [ "$DBNAME" != "$TARGET_DB" ]; then
    continue
  fi

  echo "[restore] Restoring ${DBNAME}..."
  dropdb -h "$SOCKETDIR" -U postgres --if-exists "$DBNAME"
  createdb -h "$SOCKETDIR" -U postgres "$DBNAME"
  pg_restore -h "$SOCKETDIR" -U postgres -d "$DBNAME" --no-owner --no-privileges "$dump_file"
  SIZE=$(du -h "$dump_file" | cut -f1)
  echo "[restore] ${DBNAME}: restored (${SIZE})"
  RESTORED=$((RESTORED + 1))
done

if [ -n "$TARGET_DB" ] && [ "$RESTORED" -eq 0 ]; then
  echo "[restore] ERROR: No dump found for database '$TARGET_DB'" >&2
  exit 1
fi

if [ -n "$TARGET_DB" ]; then
  echo "[restore] Single database restore complete: $TARGET_DB"
else
  echo "[restore] All database restores complete ($RESTORED databases)"
fi
POSTRESTORE
RUN chmod +x /hooks/post-restore

# ── Metadata ─────────────────────────────────────────────────

ARG VERSION=dev
LABEL org.opencontainers.image.title="Hisaabo"
LABEL org.opencontainers.image.description="Invoicing and business management — all-in-one (PostgreSQL + API)"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.source="https://github.com/hisaabo/hisaabo"

# ── Environment ──────────────────────────────────────────────

ENV NODE_ENV=production
ENV PORT=80
ENV HISAABO_VERSION=${VERSION}
# DATABASE_URL is set dynamically in the API run script (Unix socket)
# ONCE provides: SECRET_KEY_BASE, SMTP_*, VAPID_*
# Custom env vars (set via ONCE TUI): CORS_ORIGINS, APP_URL, RESEND_API_KEY, EMAIL_FROM, TURNSTILE_SECRET_KEY

EXPOSE 80

ENTRYPOINT ["/init"]
