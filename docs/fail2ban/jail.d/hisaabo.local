# /etc/fail2ban/jail.d/hisaabo.local
#
# Hisaabo API jails. All read from systemd-journald (CONTAINER_TAG=hisaabo-api).
# Tune `findtime`, `maxretry`, `bantime` to your traffic profile.
#
# Recommended starting points are below; they're conservative so a
# legitimate user fat-fingering their password 4 times in a row is NOT
# banned, but a script trying 30 in a minute IS.

[DEFAULT]
backend  = systemd
# Never ban yourself, your monitoring, or the reverse proxy / tunnel that fronts
# the API. Add your office/VPN addresses here (space separated). If a proxy on
# the host (Caddy, nginx, cloudflared) forwards the client IP, the `ip` in the
# log is the end client, but keep the proxy's own addresses here as a safeguard.
ignoreip = 127.0.0.1/8 ::1

# Which firewall chain the ban applies to depends on how traffic reaches the API:
#
#  (a) docker-compose.prod.yml default: the API port is bound to 127.0.0.1 and a
#      reverse proxy ON THE HOST (Caddy / nginx / cloudflared) listens on 80/443.
#      Client traffic hits the host's INPUT chain, so the stock actions work:
banaction = iptables-multiport
#      (use `nftables-multiport` if the host uses nftables natively)
#
#  (b) Docker publishes the web-facing port itself (e.g. you run nginx in a
#      container with `ports: 80:80`, or set API_BIND=0.0.0.0). Docker DNATs that
#      traffic and it goes through FORWARD -> DOCKER-USER, NOT INPUT, so INPUT
#      bans are silently ineffective. Ban in the DOCKER-USER chain instead:
#        banaction = iptables-multiport
#        chain     = DOCKER-USER
#      (nftables hosts: `banaction = nftables-multiport` with `chain = forward`
#      and a base chain hooked at forward priority < 0 — see fail2ban docs.)
#
# fail2ban only bans the address that appears in the log. That is correct only if
# the API computes the client IP correctly: see TRUST_PROXY_HOPS / TRUST_CLOUDFLARE
# in .env.prod.example and docs/fail2ban/README.md.

# ── Brute-force auth jail ────────────────────────────────────────
# Catches password-stuffing against /api/trpc/auth.login.
# Threshold: 8 login_fail events in 5 minutes → ban for 1 hour.
[hisaabo-api-login]
enabled  = true
filter   = hisaabo-api
journalmatch = CONTAINER_TAG=hisaabo-api + MESSAGE=+"event":"login_fail"
maxretry = 8
findtime = 300
bantime  = 3600
port     = http,https

# ── Abusive traffic jail ─────────────────────────────────────────
# Catches IPs that repeatedly trip rate limits, CSRF, or origin blocks.
# Threshold: 30 events in 2 minutes → ban for 6 hours.
# A single user hitting the in-app rate limit once is fine; an IP that
# trips it 30 times in 120 seconds is a bot.
[hisaabo-api-abuse]
enabled  = true
filter   = hisaabo-api
journalmatch = CONTAINER_TAG=hisaabo-api
maxretry = 30
findtime = 120
bantime  = 21600
port     = http,https
# This jail matches ALL event types from the filter (including login_fail),
# but a single bad login can't trip 30 in 2 minutes, so legitimate users
# are unaffected. Adjust if you raise per-email lockout thresholds.

# ── Recidive (repeat offender escalation) ────────────────────────
# fail2ban ships a `recidive` jail out of the box that bans IPs banned
# by other jails 5+ times. Enable it in /etc/fail2ban/jail.d/recidive.local
# (not shipped here, see the upstream fail2ban docs).
