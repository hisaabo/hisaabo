# Dependencies (rebuilt inside container)
node_modules/
**/node_modules/
.pnpm-store/

# Git
.git/
.gitignore

# Frontend apps (not needed in API image) — except the /ops operator
# dashboard, which the API serves (docs/architecture/queue.md §9).
apps/*
!apps/ops
apps/ops/dist
# Re-exclude after the !apps/ops negation above, which would otherwise pull a
# local apps/ops/node_modules into the build context and break `docker build`
# in any checkout where `pnpm install` has run.
apps/ops/node_modules

# Build artifacts (rebuilt inside container)
dist/
.turbo/

# Environment files (secrets injected at runtime)
.env
.env.*
!.env.example

# Dev tooling
.vscode/
.idea/
*.swp
*.swo

# Documentation
*.md
docs/
LICENSE

# Backups and data
backups/
*.csv
*.sql

# Desktop app
src-tauri/
