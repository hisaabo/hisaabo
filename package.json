{
  "name": "hisaabo",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=!@hisaabo/mobile",
    "dev:mobile": "pnpm --filter @hisaabo/mobile dev",
    "dev:mobile:android": "pnpm --filter @hisaabo/mobile dev:android",
    "build": "turbo build",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "pnpm --filter @hisaabo/db db:push",
    "db:reset": "pnpm --filter @hisaabo/db db:reset",
    "db:studio": "pnpm --filter @hisaabo/db studio",
    "lint": "pnpm exec oxlint --deny-warnings --ignore-path .gitignore ./packages ./apps",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:api": "pnpm --filter @hisaabo/shared test && pnpm --filter @hisaabo/api test"
  },
  "devDependencies": {
    "oxlint": "^1.56.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
