{
  "name": "hisaabo",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=!@hisaabo/mobile --filter=!@hisaabo/mcp --filter=!@hisaabo/cli",
    "dev:mobile": "pnpm --filter @hisaabo/mobile dev",
    "dev:mobile:android": "pnpm --filter @hisaabo/mobile dev:android",
    "build": "turbo build",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "pnpm --filter @hisaabo/db db:push",
    "db:reset": "pnpm --filter @hisaabo/db db:reset",
    "db:studio": "pnpm --filter @hisaabo/db studio",
    "lint": "pnpm exec oxlint --deny-warnings --ignore-path .gitignore --ignore-pattern '**/target/**' ./packages ./apps",
    "typecheck": "turbo typecheck",
    "test": "turbo test --concurrency 1",
    "test:api": "pnpm --filter @hisaabo/shared test && pnpm --filter @hisaabo/api test",
    "test:web": "pnpm --filter @hisaabo/web test",
    "test:mobile": "pnpm --filter @hisaabo/mobile test",
    "release": "bash scripts/release.sh",
    "release:tag": "bash scripts/release-tag.sh"
  },
  "devDependencies": {
    "oxlint": "^1.56.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.0",
      "react-dom": "19.2.0"
    }
  },
  "version": "0.6.4"
}
