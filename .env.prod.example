# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=hisaabo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=hisaabo

# ── API Server ──────────────────────────────────────────────────
PORT=3000
CORS_ORIGINS=https://app.yourdomain.com
APP_URL=https://app.yourdomain.com

# ── Field-Level Encryption (REQUIRED) ──────────────────────────
# AES-256-GCM key for encrypting sensitive data at rest (e-invoice
# credentials, carrier API keys, tenant DB passwords).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Set ONLY during key rotation, remove after rotation completes:
# ENCRYPTION_KEY_PREVIOUS=

# ── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Hisaabo <noreply@yourdomain.com>

# ── Cloudflare Turnstile ────────────────────────────────────────
TURNSTILE_SECRET_KEY=0x4AAA...

# ── Multi-tenancy (leave false for self-hosted) ─────────────────
MULTI_TENANT=false
