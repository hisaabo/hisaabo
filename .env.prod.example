# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=hisaabo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=hisaabo

# ── API Server ──────────────────────────────────────────────────
PORT=3000
# Host port / interface the API is published on (docker-compose.prod.yml).
# Default is loopback only; front it with a TLS reverse proxy. Set API_BIND=0.0.0.0
# only if you deliberately expose it (and firewall it).
# API_BIND=127.0.0.1
# API_PORT=3000
CORS_ORIGINS=https://app.yourdomain.com
APP_URL=https://app.yourdomain.com

# ── Trusted proxy / client IP (rate limiting, audit log IPs) ───
# Forwarding headers are attacker-controlled unless set by a proxy YOU run.
# TRUST_PROXY_HOPS = number of trusted reverse proxies in front of the API that
#   each append to X-Forwarded-For (client IP = Nth entry from the right).
#   1 (default) = a single nginx/Caddy/load balancer. 0 = API exposed directly:
#   forwarding headers are ignored entirely.
TRUST_PROXY_HOPS=1
# TRUST_CLOUDFLARE=true makes the API honour cf-connecting-ip. Enable ONLY if the
# API is reachable exclusively through Cloudflare (Tunnel / firewall to CF ranges);
# otherwise anyone can spoof the header. The bundled nginx/nginx.conf strips this
# header unless you configure its real_ip block for Cloudflare.
TRUST_CLOUDFLARE=false

# ── Field-Level Encryption (REQUIRED) ──────────────────────────
# AES-256-GCM key for encrypting sensitive data at rest (e-invoice
# credentials, carrier API keys, tenant DB passwords).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Set ONLY during key rotation, remove after rotation completes:
# ENCRYPTION_KEY_PREVIOUS=

# ── Export / import token signing (optional) ───────────────────
# Secret used to sign self-import tokens. Optional, but recommended: if unset the
# API falls back to SESSION_SECRET and then to a built-in development default,
# so set a strong value in production. A dedicated secret keeps this separate
# from other secrets.
# Generate with: openssl rand -hex 32
# EXPORT_SECRET=

# ── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Hisaabo <noreply@yourdomain.com>

# ── Cloudflare Turnstile ────────────────────────────────────────
# Required in production: gates the online-store order and phone-lookup endpoints.
# Backend secret key (https://dash.cloudflare.com/?to=/:account/turnstile).
# The matching site key (VITE_TURNSTILE_SITE_KEY) is a build-time variable of the
# store frontend, not read by the API.
TURNSTILE_SECRET_KEY=0x4AAA...

# ── Multi-tenancy (leave false for self-hosted) ─────────────────
MULTI_TENANT=false

# ── Backup ─────────────────────────────────────────────────────
# Passphrase used to encrypt backup files. REQUIRED if R2/S3 offsite upload is
# configured: the backup job refuses to upload unencrypted dumps. Store this key
# somewhere other than the server — without it backups cannot be restored.
# Generate: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=
# R2/S3 offsite backup storage (optional — backups still saved locally without this)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=hisaabo-backups
# Cron schedule for automated backups (default: daily 2 AM UTC)
BACKUP_CRON=0 2 * * *
# Local backup retention in days
BACKUP_RETENTION_DAYS=30

# ── Browser AI agents (WebMCP) ──────────────────────────────────
# Origin-trial token that enables the WebMCP API (document.modelContext) in
# Chrome 149+ / Edge 150+, so the browser's built-in AI agent can discover the
# tools the web app registers. Register a token for YOUR origin at:
#   https://developer.chrome.com/origintrials
# Tokens are per-origin — register one for the origin you serve the app from
# (e.g. https://app.yourdomain.com). Not needed once the API ships in stable,
# or when testing with chrome://flags/#enable-webmcp-testing.
VITE_WEBMCP_ORIGIN_TRIAL_TOKEN=
