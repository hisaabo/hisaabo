# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=hisaabo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=hisaabo

# ── API image ───────────────────────────────────────────────────
# Which API image docker-compose.prod.yml runs. Unset = ghcr.io/hisaabo/hisaabo-api:latest,
# which moves with every stable release. For production, pin a release (and
# upgrade by editing this line). Append @sha256:<digest> (listed in the
# release notes) to pin the exact bytes. Needs `--env-file .env.prod`.
# Do NOT set HISAABO_VERSION / HISAABO_COMMIT: the image sets them.
# HISAABO_API_IMAGE=ghcr.io/hisaabo/hisaabo-api:v0.10.0

# ── API Server ──────────────────────────────────────────────────
PORT=3000
# Log level: debug | info | warn | error (default info in production).
# LOG_LEVEL=info
# Host port / interface the API is published on (docker-compose.prod.yml).
# Default is loopback only; front it with a TLS reverse proxy. Set API_BIND=0.0.0.0
# only if you deliberately expose it (and firewall it).
# API_BIND=127.0.0.1
# API_PORT=3000
CORS_ORIGINS=https://app.yourdomain.com
APP_URL=https://app.yourdomain.com
# Recommended: public base URL of this API. Used for absolute links (UPI pay
# links in PDFs) and store share metadata. If unset the API still starts and
# logs a warning, falling back to the request origin for PDFs and to APP_URL
# (then the first CORS_ORIGINS entry) elsewhere; that is wrong when the API is
# served from a different host than the app, so set it. A SET value must be a
# valid http(s) URL or startup fails.
API_PUBLIC_URL=https://api.yourdomain.com

# ── Online store (optional) ─────────────────────────────────────
# Public base URL of the storefront, used as the canonical URL in share metadata
# (Open Graph). Unset = the API's own public base URL.
# STORE_PUBLIC_URL=https://store.yourdomain.com
# Extra origins (comma-separated, full origins) and parent domains (any subdomain)
# allowed to call the public store endpoints, in addition to CORS_ORIGINS.
# STORE_ALLOWED_ORIGINS=https://shop.example.com
# STORE_ALLOWED_SUBDOMAINS_OF=yourdomain.com
# Directory with the OG image fonts (NotoSans-Regular.ttf, NotoSans-Bold.ttf).
# Default: the fonts bundled with the API. Only set for a custom image.
# OG_FONT_DIR=/app/packages/api/fonts

# ── Item image storage ──────────────────────────────────────────
# local (default) keeps images in /storage/objects, which docker-compose.prod.yml
# pins and mounts as the api_storage volume (STORAGE_LOCAL_DIR here has no effect
# with that compose file). s3 = any S3-compatible bucket (R2, AWS S3, MinIO); the
# first four STORAGE_S3_* values below are then required (image uploads fail without them).
# STORAGE_DRIVER=local
# STORAGE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# STORAGE_S3_BUCKET=hisaabo-item-images
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_REGION=auto

# ── Sign-up policy (self-hosted) ────────────────────────────────
# The first user becomes the owner; after that sign-up is by invitation only
# (Settings → Team). Set to true to allow anyone to create an account.
# UPGRADING from v0.9.x: earlier versions allowed open sign-up. If your server
# relied on that (users registering themselves), set ALLOW_OPEN_SIGNUP=true
# here after upgrading to keep the old behaviour. Existing accounts are not
# affected either way.
# ALLOW_OPEN_SIGNUP=false

# ── Native sign-in app links (web build-time) ───────────────────
# Desktop/mobile/CLI sign in through the system browser. For mobile app links to
# verify, the web build publishes /.well-known/assetlinks.json and
# apple-app-site-association from these values.
# VITE_ANDROID_APP_CERT_SHA256=AB:CD:...,EF:01:...   # comma-separated
# VITE_APPLE_TEAM_ID=ABCDE12345

# ── Trusted proxy / client IP (rate limiting, audit log IPs) ───
# Forwarding headers are attacker-controlled unless set by a proxy YOU run.
# TRUST_PROXY_HOPS = number of trusted reverse proxies in front of the API that
#   each append to X-Forwarded-For (client IP = Nth entry from the right).
#   1 (default) = a single nginx/Caddy/load balancer. 0 = API exposed directly:
#   forwarding headers are ignored entirely.
TRUST_PROXY_HOPS=1
# TRUST_CLOUDFLARE=true makes the API honour cf-connecting-ip. Enable ONLY if the
# API is reachable exclusively through Cloudflare (Tunnel / firewall to CF ranges);
# otherwise anyone can spoof the header. The bundled nginx/nginx.conf strips this
# header unless you configure its real_ip block for Cloudflare.
TRUST_CLOUDFLARE=false

# ── Field-Level Encryption (REQUIRED) ──────────────────────────
# AES-256-GCM key for encrypting sensitive data at rest (e-invoice
# credentials, carrier API keys, tenant DB passwords). Must be exactly 64 hex
# characters (32 bytes); a malformed key makes the server log a warning at
# startup (and refuse to start when MULTI_TENANT=true), and saving e-invoice /
# carrier credentials will fail until it is fixed.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Set ONLY during key rotation, remove after rotation completes:
# ENCRYPTION_KEY_PREVIOUS=
# Legacy name: DB_ENCRYPTION_KEY is read when ENCRYPTION_KEY is unset, but startup
# validation in production / multi-tenant mode requires ENCRYPTION_KEY itself.
# Keep the SAME key when upgrading: it also protects tenant database passwords.

# ── Export / import token signing (optional) ───────────────────
# Export/import tokens and store OTP codes are signed with a key derived from the
# first of ENCRYPTION_KEY, SESSION_SECRET, EXPORT_SECRET that is set. Production
# requires ENCRYPTION_KEY, so these two only act as lower-priority fallbacks:
# leave them unset unless you know you need them.
# Generate with: openssl rand -hex 32
# SESSION_SECRET=
# EXPORT_SECRET=

# ── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Hisaabo <noreply@yourdomain.com>

# ── Notifications (docs/architecture/notifications.md §8–10) ────
# Mobile push needs your own app build + Apple/Firebase credentials and a
# Gorush sidecar (docker-compose.push.yml pattern in the design doc). Without
# it, users still get the in-app inbox, plus email copies of critical alerts
# when RESEND_API_KEY is set (without it the email copies are skipped with one
# warning per process).
# PUSH_PROVIDER=gorush
# GORUSH_URL=http://gorush:8088        # private network only — never publish Gorush's port
# APNS_TOPIC=in.hisaabo.app
# Push quotas (cloud defaults shown; self-hosted defaults to unlimited except per-user caps)
# PUSH_INSTANCE_ID=prod
# PUSH_QUOTA_INSTANCE_DAY=2000000
# PUSH_QUOTA_INSTANCE_MINUTE=2000
# PUSH_QUOTA_USER_HOUR=60
# PUSH_QUOTA_USER_DAY=200
# Background workers (outbox dispatcher + hourly collections sweep).
# NOTIFICATIONS_WORKER=                # true | false. Unset = on for single-tenant, OFF when MULTI_TENANT=true.
#   Set false on replicas that should only serve requests. Anything other than true/false
#   (case-insensitive) is ignored with a warning and the default applies.
#   MULTI_TENANT deployments are off by default because today's worker scans every tenant
#   database every NOTIFICATIONS_FULL_SWEEP_SECONDS (one short-lived connection per tenant), which
#   takes time and load when there are many tenants. Set
#   NOTIFICATIONS_WORKER=true on the replica(s) that should dispatch (it is safe on several)
#   once you accept that load, until the queue-backed dispatcher lands.
#   With the worker off on EVERY replica nothing is dispatched (no inbox rows, no pushes);
#   events keep queuing in notification_outbox; events older than 72 h are expired, not delivered.
# NOTIFICATIONS_FULL_SWEEP_SECONDS=60  # multi-tenant only; raise to scan tenants less often (min 5)

# ── Cloudflare Turnstile ────────────────────────────────────────
# Required in production: gates the online-store order and phone-lookup endpoints.
# Backend secret key (https://dash.cloudflare.com/?to=/:account/turnstile).
# The matching site key (VITE_TURNSTILE_SITE_KEY) is a build-time variable of the
# store frontend, not read by the API.
TURNSTILE_SECRET_KEY=0x4AAA...
# DEPRECATED, removed in 0.11.0. Installed v0.9.x mobile/desktop apps cannot solve a
# Turnstile challenge, so by default a token-less magic-link request from them is
# accepted (existing/invited users only, max 10 links per address per 24h) and
# sign-in keeps working until they are updated. Set to false to turn off ALL v0.9.x
# client compatibility (this exemption, the bearer-token signature and the app handoff).
# LEGACY_V09_CLIENT_COMPAT=false

# ── Public version endpoint ─────────────────────────────────────
# GET /api/version returns {"version":"x.y.z"} to anyone (no commit, no health data).
# The project's release workflow polls it before it deploys the frontends. Set to
# false if you do not want the exact version readable by the public; the endpoint
# then answers 404.
# EXPOSE_VERSION=false

# ── Store phone OTP (optional, per-store toggle in Store settings) ──
# A store can only enable phone OTP when a provider is configured.
# SMS_PROVIDER=webhook                 # console (dev only) | webhook
# SMS_WEBHOOK_URL=https://sms.example.com/send   # receives {"to":"+91<phone>","message":"..."}
# SMS_WEBHOOK_SECRET=                  # X-Hisaabo-Signature = hex HMAC-SHA256(secret, body)

# ── Carrier webhooks ────────────────────────────────────────────
# Timestamps are optional by default; true rejects webhooks without a valid one.
# SHIPPING_WEBHOOK_REQUIRE_TIMESTAMP=false
# HMAC-SHA256 secret for POST /webhooks/shipping/:businessId. Without it that
# endpoint answers 503.
# SHIPPING_WEBHOOK_SECRET=

# ── E-way bills (optional) ──────────────────────────────────────
# Server-wide NIC E-Way Bill API credentials; all four are needed to generate
# e-way bills. E-invoice (IRP) credentials are entered per business in the app.
# NIC_EWB_CLIENT_ID=
# NIC_EWB_CLIENT_SECRET=
# NIC_EWB_USERNAME=
# NIC_EWB_PASSWORD=
# Calls go to the NIC sandbox unless this is exactly "false". Set false in production.
# NIC_EWB_SANDBOX=false

# ── Multi-tenancy (leave false for self-hosted) ─────────────────
MULTI_TENANT=false
# Multi-tenant only: control database (users, tenants). Must be a direct (or
# session-mode pooler) connection: cache invalidation uses LISTEN/NOTIFY.
# CONTROL_DATABASE_URL=

# ── Migrations (optional) ───────────────────────────────────────
# DDL gives up if it cannot get its table lock within MIGRATION_LOCK_TIMEOUT (a number
# with optional ms/s/min suffix; 0 disables; default 5s) and is retried with backoff
# MIGRATION_LOCK_RETRIES times (default 5). Raise both on a busy database.
# MIGRATION_LOCK_TIMEOUT=5s
# MIGRATION_LOCK_RETRIES=5

# ── Backup ─────────────────────────────────────────────────────
# Passphrase used to encrypt backup files. REQUIRED if R2/S3 offsite upload is
# configured: the backup job refuses to upload unencrypted dumps. Store this key
# somewhere other than the server — without it backups cannot be restored.
# Generate: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=
# R2/S3 offsite backup storage (optional — backups still saved locally without this)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=hisaabo-backups
# Cron schedule for automated backups (default: daily 2 AM UTC)
BACKUP_CRON=0 2 * * *
# Local backup retention in days
BACKUP_RETENTION_DAYS=30

# ── Browser AI agents (WebMCP) ──────────────────────────────────
# Origin-trial token that enables the WebMCP API (document.modelContext) in
# Chrome 149+ / Edge 150+, so the browser's built-in AI agent can discover the
# tools the web app registers. Register a token for YOUR origin at:
#   https://developer.chrome.com/origintrials
# Tokens are per-origin — register one for the origin you serve the app from
# (e.g. https://app.yourdomain.com). Not needed once the API ships in stable,
# or when testing with chrome://flags/#enable-webmcp-testing.
# WebMCP is OFF by default for every user (opt-in in Settings) and write tools
# always ask for confirmation in an in-app dialog.
VITE_WEBMCP_ORIGIN_TRIAL_TOKEN=

# ── Background jobs (queue worker) ────────────────────────────
# Jobs live in Postgres (pgboss schema). Run the worker next to the API:
#   docker-compose.prod.yml `worker` service (same image, `command: worker`)
# QUEUE_POOLS=default,heavy,system
# QUEUE_CONCURRENCY_DEFAULT=8
# QUEUE_COMPLETED_RETENTION_HOURS=24
# QUEUE_FAILED_RETENTION_DAYS=14
# QUEUE_SHUTDOWN_GRACE_SECONDS=25
# QUEUE_PING_SCHEDULE=false
# Database holding the queue (pgboss schema). Default: CONTROL_DATABASE_URL, then
# DATABASE_URL. Only set it to reach the same database through a direct URL.
# QUEUE_DATABASE_URL=
# Idle poll interval of the worker in seconds (default 2, minimum 0.5).
# QUEUE_POLLING_INTERVAL_SECONDS=2
# File the worker touches every 10 s for the compose healthcheck. Change it only
# together with that healthcheck.
# QUEUE_HEARTBEAT_FILE=/tmp/worker-heartbeat

# ── Operator dashboard (/ops) ─────────────────────────────────
# Horizon-style queue dashboard served by the API at /ops. OFF unless "true".
# Needs ENCRYPTION_KEY (operator TOTP secrets are encrypted with it).
# Operators are added and enrolled ONLY from the shell:
#   docker compose exec api node packages/api/dist/bin/ops.js help
# See docs/architecture/queue.md §7.2 and docs/DEPLOYMENT.md.
# QUEUE_DASHBOARD_ENABLED=false
# Comma-separated CIDRs allowed to reach /ops (others get a plain 404).
# Strongly recommended in production, e.g. your VPN / office egress.
# OPS_IP_ALLOWLIST=203.0.113.0/24,2001:db8::/32
# OPS_SESSION_IDLE_MINUTES=15
# OPS_SESSION_MAX_HOURS=8
# OPS_STEP_UP_MINUTES=5
